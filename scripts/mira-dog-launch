#!/usr/bin/env bash
# Run the PyGDO Dog with a stable, tail-able combined stdout/stderr log.
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
log_file=${MIRA_DOG_LOG:-/home/mira/dog-live.log}
# Keep the production Dog on the stable interpreter. A free-threaded runtime
# can still be selected explicitly for isolated diagnostics via PYGDO_PYTHON.
python_bin=${PYGDO_PYTHON:-python3}

mkdir -p -- "$(dirname -- "$log_file")"
backup_config=protected/config.toml
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
    case "${args[i]}" in
        --config=*) backup_config=${args[i]#--config=} ;;
        --config)
            if ((i + 1 >= ${#args[@]})); then
                printf '%s\n' 'Dog not started: --config requires a path.' >>"$log_file"
                exit 1
            fi
            backup_config=${args[i+1]}
            ((i+=1))
            ;;
    esac
done
if ! "$project_dir/gdo_backup.sh" "--config=$backup_config" >>"$log_file" 2>&1; then
    printf '%s\n' 'Dog not started: backup failed.' >>"$log_file"
    exit 1
fi
exec env PYGDO_USER=mira "$python_bin" "$project_dir/bin/pygdo.py" '.launch' "$@" >>"$log_file" 2>&1
