#!/usr/bin/env bash
# Run the PyGDO Dog with a stable, tail-able combined stdout/stderr log.
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
log_file=${MIRA_DOG_LOG:-/home/mira/dog-live.log}
# Keep the production Dog on the stable interpreter. A free-threaded runtime
# can still be selected explicitly for isolated diagnostics via PYGDO_PYTHON.
python_bin=${PYGDO_PYTHON:-python3}

mkdir -p -- "$(dirname -- "$log_file")"
backup_config=protected/config.toml
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
    case "${args[i]}" in
        --config=*) backup_config=${args[i]#--config=} ;;
        --config)
            if ((i + 1 >= ${#args[@]})); then
                printf '%s\n' 'Dog not started: --config requires a path.' >>"$log_file"
                exit 1
            fi
            backup_config=${args[i+1]}
            ((i+=1))
            ;;
    esac
done
backup_command=("$project_dir/gdo_backup.sh")
backup_dir="$project_dir/protected/backup"
# The private backup directory can be owned by the project operator while
# Dog runs as Mira. Keep backups private and use the owner for this step.
if [[ -d "$backup_dir" && ! -w "$backup_dir" ]]; then
    backup_owner=$(stat -c '%U' -- "$backup_dir")
    if [[ "$backup_owner" != gizmore ]]; then
        printf '%s\n' 'Dog not started: backup directory owner is not gizmore.' >>"$log_file"
        exit 1
    fi
    backup_command=(sudo -n -u gizmore -- "$project_dir/gdo_backup.sh")
fi
if ! "${backup_command[@]}" "--config=$backup_config" >>"$log_file" 2>&1; then
    printf '%s\n' 'Dog not started: backup failed.' >>"$log_file"
    exit 1
fi
exec env PYGDO_USER=mira "$python_bin" "$project_dir/bin/pygdo.py" '.launch' "$@" >>"$log_file" 2>&1
